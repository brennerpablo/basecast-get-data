# Copy to .env and fill in. Never commit .env.
# Production values are the defaults in basecast_get_data/config.py; set only what differs locally.

# Bearer token the app's BFF sends on every request (the app's GET_DATA_TOKEN)
API_TOKEN=
# The lake: basecast-airflow's local mirror (production reads gs://basecast-509812-lake)
LAKE_ROOT=../basecast-airflow/data
# Postgres through the Cloud SQL proxy, as basecast_reader (Secret Manager: pg-basecast-reader-password)
PG_HOST=127.0.0.1
PG_PORT=5439
PG_PASSWORD=
# Product resources: fixtures (data/fixtures) or marts (public.mart_*); MARTS_LIVE lists the groups
# (accounts, explorer, forecast, backtest) that read the marts while DATA_MODE=fixtures
DATA_MODE=fixtures
# MARTS_LIVE=accounts
# Optional
# GCP_PROJECT=basecast-509812
# BQ_DATASET=basecast
# BQ_MAX_BYTES_BILLED=2000000000
# PREVIEW_MAX_BYTES=120000000
# CACHE_DIR=/tmp/basecast-get-data
